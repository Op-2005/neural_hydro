% arxiv.sty — preprint style, faithful to kourgeorge/arxiv-style
% Times/Helvetica, 6.5in x 9in text block, "A Preprint" fancy header,
% small-caps ruled \maketitle, centered small-caps abstract, \keywords.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2024/01/01 v1.0 arXiv preprint style]

% ---- page geometry ----
\RequirePackage[letterpaper,textwidth=6.5in,textheight=9in,%
  headheight=14pt,headsep=25pt,footskip=30pt]{geometry}

% ---- fonts: Times (text) + Helvetica (sans) ----
\RequirePackage{mathptmx}   % Times-like text + math
\RequirePackage{helvet}     % Helvetica for sans-serif
\renewcommand{\familydefault}{\rmdefault}

% ---- headers / footers ----
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyheadoffset{0pt}
% \headtitle is set by \maketitle from the document \title
\newcommand{\headtitle}{}
\fancyhead[L]{\footnotesize\scshape\headtitle}
\fancyhead[R]{\footnotesize\scshape A Preprint}
\fancyfoot[C]{\thepage}

% ---- section spacing (compact, per arxiv-style) ----
\RequirePackage{titlesec}
\titlespacing*{\section}{0pt}{2.0ex plus 1ex minus .2ex}{1.2ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 1ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus 1ex minus .2ex}{0.8ex plus .2ex}
\titleformat{\section}{\normalfont\Large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\large\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries}{\thesubsubsection}{1em}{}

% ---- title block: small-caps title inside horizontal rules ----
\renewcommand{\maketitle}{%
  \newpage\null
  \begin{center}%
    \rule{\textwidth}{1pt}\par\vskip 4pt
    {\LARGE\scshape\@title\par}\vskip 4pt
    \rule{\textwidth}{1pt}\par\vskip 18pt
    {\large\lineskip .5em\@author\par}\vskip 12pt
    {\@date\par}%
  \end{center}%
  \par\vskip 12pt
  % feed the running header from the title
  \protected@edef\headtitle{\@title}%
  \thispagestyle{fancy}%
}

% ---- abstract: centered small-caps heading, quoted block ----
\renewenvironment{abstract}{%
  \centerline{\normalfont\bfseries\scshape\abstractname}%
  \vspace{0.4em}%
  \begin{quote}\small
}{%
  \end{quote}%
}

% ---- \keywords ----
\providecommand{\keywords}[1]{%
  \vspace{0.5em}\noindent{\small\textbf{Keywords:} #1}\par\vspace{0.5em}%
}

% ---- widow / orphan control ----
\widowpenalty=10000
\clubpenalty=10000

\endinput
